#!/bin/sh
# P1.C: refuse to commit if the loose ed25519 verifier symbol exists.
# The strict helper is `verify_ed25519_ix_strict` — anything matching the bare
# `verify_ed25519_ix\b` is the buggy variant and must not exist.
#
# Earlier audit drafts of the nav-oracle update.rs included a permissive
# `verify_ed25519_ix` helper alongside the strict one. The strict version is
# the ONLY ed25519 verifier; the loose name must never reappear.
if grep -rE 'fn verify_ed25519_ix\b' programs/nav-oracle/src/ ; then
  echo "Found bare verify_ed25519_ix helper. The canonical name is verify_ed25519_ix_strict."
  echo "Delete the bare-name definition before committing."
  exit 1
fi
