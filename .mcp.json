{
  "mcpServers": {
    "helius": {
      "command": "npx",
      "args": ["-y", "helius-mcp@3.1.0"],
      "env": {
        "HELIUS_API_KEY": "${HELIUS_API_KEY}"
      }
    },
    "solana-dev": {
      "command": "npx",
      "args": ["-y", "mcp-remote@0.16.6", "https://mcp.solana.com/mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.7.0"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.85", "--headless"]
    },
    "context-mode": {
      "command": "npx",
      "args": ["-y", "context-mode@2.1.10"]
    }
  }
}
